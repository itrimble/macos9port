<?xml version="1.0" encoding="UTF-8"?>
<!-- OS999 launch screen: the periwinkle desktop colour with the folding-phone mark. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="os9-vc-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23000"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="os9-scene-01">
            <objects>
                <viewController id="os9-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="os9-view-01">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="os9-mark-01">
                                <rect key="frame" x="136.66666666666666" y="366" width="120" height="120"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="120" id="os9-c-w"/>
                                    <constraint firstAttribute="height" constant="120" id="os9-c-h"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="os9-safe-01"/>
                        <color key="backgroundColor" red="0.357" green="0.443" blue="0.635" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="os9-mark-01" firstAttribute="centerX" secondItem="os9-view-01" secondAttribute="centerX" id="os9-c-x"/>
                            <constraint firstItem="os9-mark-01" firstAttribute="centerY" secondItem="os9-view-01" secondAttribute="centerY" id="os9-c-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="os9-fr-01" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
